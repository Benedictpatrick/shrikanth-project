# Copy to .env (same folder as this file) and fill in.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Any model your Groq account can use; list them with GET /api/llm/models once the key is set.
GROQ_MODEL=llama-3.3-70b-versatile
MAX_REPAIR_ATTEMPTS=3
# WORKSPACE_DIR=./workspace

# Client-side throttle: set to YOUR Groq plan's limits for the chosen model
# (see https://console.groq.com/settings/limits). Prompts are sized and calls paced to stay below them.
GROQ_RPM=25
GROQ_TPM=12000
